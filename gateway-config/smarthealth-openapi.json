  "info": {
    "title": "SmartHealth API",
    "description": "Interactive OpenAPI documentation for the SmartHealth API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "doctor@smarthealth.com"
          },
          "password": {
            "type": "string",
            "example": "securepassword123"
          },
          "role": {
            "type": "string",
            "example": "DOCTOR",
            "description": "Role of the new account (DOCTOR or ADMIN)",
            "enum": [
              "DOCTOR",
              "ADMIN"
            ],
            "default": "DOCTOR"
          },
          "firstName": {
            "type": "string",
            "example": "Jean"
          },
          "lastName": {
            "type": "string",
            "example": "Rakoto"
          },
          "specialty": {
            "type": "string",
            "example": "Cardiologue"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "doctor@smarthealth.com"
          },
          "password": {
            "type": "string",
            "example": "securepassword123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreatePatientDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Jean"
          },
          "lastName": {
            "type": "string",
            "example": "Rakoto"
          },
          "birthDate": {
            "type": "string",
            "example": "1990-01-01"
          },
          "gender": {
            "type": "string",
            "example": "male",
            "enum": [
              "male",
              "female",
              "other"
            ]
          }
        },
        "required": [
          "firstName",
          "lastName",
          "birthDate",
          "gender"
        ]
      },
      "FhirPatientDto": {
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "description": "FHIR R4 resourceType — must be \"Patient\"",
            "example": "Patient"
          },
          "id": {
            "type": "string",
            "description": "FHIR logical ID (from Synthea)",
            "example": "ab12cd34-ef56-7890-abcd-ef1234567890"
          }
        },
        "required": [
          "resourceType"
        ]
      },
      "CreatePractitionerDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Marc"
          },
          "lastName": {
            "type": "string",
            "example": "Dupont"
          },
          "specialty": {
            "type": "string",
            "example": "Cardiologist"
          },
          "email": {
            "type": "string",
            "example": "marc.dupont@hopital.fr"
          },
          "phone": {
            "type": "string",
            "example": "+33123456789"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "specialty"
        ]
      },
      "UpdatePractitionerDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Marc"
          },
          "lastName": {
