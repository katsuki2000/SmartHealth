    "/fhir/Patient": {
      "post": {
        "description": "Accepts any valid FHIR R4 Patient JSON directly (no wrapper). Stores it in the FhirResource JSONB table and publishes a \"fhir.patient.created\" event on RabbitMQ.",
        "operationId": "FhirPatientController_createFhirPatient",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FhirPatientDto"
              },
              "examples": {
                "fhir_r4_patient": {
                  "summary": "FHIR R4 Patient",
                  "description": "The body IS the FHIR R4 resource directly (hospital, lab, medical device, etc.).",
                  "value": {
                    "resourceType": "Patient",
                    "id": "synthea-abc123",
                    "name": [
                      {
                        "family": "Rakoto",
                        "given": [
                          "Jean"
                        ]
                      }
                    ],
                    "gender": "male",
                    "birthDate": "1990-01-01",
                    "address": [
                      {
                        "use": "home",
                        "city": "Antananarivo",
                        "country": "MG"
                      }
                    ],
                    "telecom": [
                      {
                        "system": "phone",
                        "value": "+261 20 22 000 00"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "FHIR Patient stored + event emitted"
          },
          "400": {
            "description": "Invalid resourceType"
          }
        },
        "summary": "Ingest a FHIR R4 Patient resource",
        "tags": [
          "FHIR Resources"
        ]
      },
      "get": {
        "operationId": "FhirPatientController_findAllFhirPatients",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of FHIR Patients"
          }
        },
        "summary": "List all FHIR Patient resources (JSONB)",
        "tags": [
          "FHIR Resources"
        ]
      }
    },
