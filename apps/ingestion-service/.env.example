# ═══════════════════════════════════════════════════════════════
# SmartHealth — Ingestion Service — Configuration (Example)
# ═══════════════════════════════════════════════════════════════

# Environnement
NODE_ENV=development

# Database Config (Local Postgres)
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/health_db?schema=public"

# Auth Config
JWT_SECRET="change-this-to-a-random-secret-key"
JWT_EXPIRATION="24h"

# RabbitMQ Config
RABBITMQ_URL="amqp://guest:guest@localhost:5673"
RABBITMQ_EXCHANGE="smarthealth.events"

# FHIR Sync Config 
FHIR_SERVER_URL="http://localhost:8080/fhir"

# Temporal Server
TEMPORAL_ADDRESS=localhost:7233

# Admin seed password
ADMIN_PASSWORD=Admin123!
