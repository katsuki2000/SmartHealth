# ─── Base de données PostgreSQL ─────────────────────────
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/NOM_DE_LA_BASE?schema=public
# Remplacez "postgres" et "votre_mot_de_passe" par vos identifiants locaux
DATABASE_URL="postgresql://postgres:votre_mot_de_passe@localhost:5432/health_db?schema=public"

# ─── Authentification JWT ───────────────────────────────
# Clé secrète pour signer les tokens (changez-la pour chaque environnement)
JWT_SECRET="changez-moi-par-une-cle-secrete-aleatoire"
JWT_EXPIRATION="24h"

# ─── RabbitMQ (Bus de messages) ─────────────────────────
# Par défaut, RabbitMQ utilise guest:guest sur le port 5672
# Le port 5673 est utilisé ici ; adaptez selon votre configuration
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE="smarthealth.events"

# ─── FHIR (Optionnel — Serveur FHIR externe) ───────────
FHIR_SERVER_URL="http://localhost:8080/fhir"
