# ═══════════════════════════════════════════════════════════════
# SmartHealth — Dashboard UI — Configuration (Example)
# ═══════════════════════════════════════════════════════════════

# On utilise le proxy interne (/api/v1) pour éviter les erreurs CORS 
# et laisser Vite gérer l'authentification WSO2 en arrière-plan.
VITE_API_BASE_URL=/api/v1

# --- WSO2 API Gateway Configuration (utilisé par vite.config.ts) ---
VITE_WSO2_GATEWAY=https://localhost:8243/smarthealth/1.0.0
VITE_WSO2_CONSUMER_KEY=your_wso2_consumer_key
VITE_WSO2_CONSUMER_SECRET=your_wso2_consumer_secret
